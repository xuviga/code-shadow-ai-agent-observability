{
  "name": "opencode-code-shadow",
  "version": "0.5.3",
  "description": "Persistent memory, risk intelligence, and task guardrails for OpenCode AI agents",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/v2.ts",
    "./v1": "./src/index.ts",
    "./v2": "./src/v2.ts",
    "./tui": "./src/tui-v2.ts",
    "./tui-v1": "./tui-plugin.tsx"
  },
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agent",
    "agent-observability",
    "agent-memory",
    "developer-productivity",
    "software-maintenance",
    "analytics",
    "code-health",
    "developer-tools",
    "shadow"
  ],
  "author": "xuviga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuviga/code-shadow-ai-agent-observability.git"
  },
  "homepage": "https://github.com/xuviga/code-shadow-ai-agent-observability#readme",
  "bugs": {
    "url": "https://github.com/xuviga/code-shadow-ai-agent-observability/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode/plugin": "^2.3.0"
  },
  "files": [
    "src/",
    "scripts/",
    "docs/",
    "tui-plugin.tsx",
    "tui.jsonc",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {},
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode/plugin": "^2.3.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:tui": "tsc -p tsconfig.tui.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "doctor": "node scripts/doctor.js",
    "postinstall": "node scripts/postinstall.js"
  }
